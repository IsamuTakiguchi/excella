{
  "name": "excella",
  "version": "0.1.0",
  "description": "Excel ライクな表計算アプリ（デスクトップ版と PWA）",
  "main": "./out/main/index.js",
  "author": "excella contributors",
  "license": "GPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "electron-vite build",
    "build:web": "vite build --config vite.web.config.ts",
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "dist": "npm run build && electron-builder",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "preview:web": "vite preview --config vite.web.config.ts",
    "smoke": "electron-vite build && electron ./out/main/index.js --smoke",
    "smoke:headless": "electron-vite build && xvfb-run -a electron ./out/main/index.js --smoke --no-sandbox",
    "smoke:web": "npm run build:web && node scripts/web-smoke.mjs",
    "start": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "hyperformula": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.0",
    "zustand": "^5.0.2"
  },
  "desktopName": "excella.desktop"
}
